generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InstitutionType {
  SCHOOL
  COLLEGE
  MADRASAH
}

enum MembershipRole {
  INSTITUTION_OWNER
  ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  GUARDIAN
  ACCOUNTANT
  STAFF
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Institution {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  type         InstitutionType
  /// ISO-4217 code. Monetary columns added later use integer minor units plus this code; never floating point.
  currencyCode String           @default("BDT") @db.Char(3)
  timezone     String           @default("Asia/Dhaka")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  campuses     Campus[]
  memberships  Membership[]

  @@map("institutions")
}

model Campus {
  id            String       @id @default(cuid())
  institutionId String
  name          String
  code          String
  address       String?
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  memberships   Membership[]

  @@unique([institutionId, code])
  @@unique([id, institutionId])
  @@index([institutionId])
  @@map("campuses")
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  emailVerifiedAt DateTime?
  locale          String       @default("bn")
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]

  @@map("users")
}

model Membership {
  id            String           @id @default(cuid())
  userId        String
  institutionId String
  campusId      String?
  role          MembershipRole
  status        MembershipStatus @default(INVITED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  campus        Campus?          @relation(fields: [campusId, institutionId], references: [id, institutionId], onDelete: Restrict)

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([campusId, institutionId])
  @@map("memberships")
}
